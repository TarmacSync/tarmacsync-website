{
  "cleanUrls": true,
  "redirects": [
    { "source": "/founding-airports.html", "destination": "/", "statusCode": 301 },
    { "source": "/founding-airports", "destination": "/", "statusCode": 301 },
    { "source": "/pilot-program-brief.html", "destination": "/", "statusCode": 301 },
    { "source": "/pilot-program-brief", "destination": "/", "statusCode": 301 },
    { "source": "/privacy-choices.html", "destination": "/privacy#your-choices", "statusCode": 301 },
    { "source": "/privacy-choices", "destination": "/privacy#your-choices", "statusCode": 301 },
    { "source": "/product-roadmap.html", "destination": "/", "statusCode": 301 },
    { "source": "/product-roadmap", "destination": "/", "statusCode": 301 },
    { "source": "/procurement-support-packet.html", "destination": "/pricing", "statusCode": 301 },
    { "source": "/procurement-support-packet", "destination": "/pricing", "statusCode": 301 },
    { "source": "/airport-procurement-intelligence.html", "destination": "/", "statusCode": 301 },
    { "source": "/airport-procurement-intelligence", "destination": "/", "statusCode": 301 },
    {
      "source": "/(.*)",
      "has": [
        { "type": "host", "value": "tarmacsync.com" }
      ],
      "destination": "https://www.tarmacsync.com/$1",
      "statusCode": 301
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/assets/(.*)\\.(png|jpg|jpeg|webp|svg|ico|woff2)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    }
  ]
}
